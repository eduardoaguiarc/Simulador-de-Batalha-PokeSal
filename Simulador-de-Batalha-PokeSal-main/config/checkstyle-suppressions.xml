<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
  <!-- Nomes exigidos literalmente pelo enunciado, com UCSal e ODia. -->
  <suppress checks="AbbreviationAsWordInName"
      files=".*Test\.java"
      message=".*(testEfeitoTerrenoEstacionamentoUCSal|testAsfaltoQuenteApenasDuranteODia).*"/>
</suppressions>
